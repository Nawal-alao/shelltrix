# Python environment
.venv/
__pycache__/
*.py[cod]
*$py.class

# Build and packages
build/
dist/
*.egg-info/
*.egg
wheels/

# Rust core (shelltrix-core): compiled artifacts and cargo caches.
# Cargo.lock is deliberately NOT ignored: it is committed, so a wheel is
# built from pinned dependency versions and a release is reproducible.
target/
*.so
*.dylib
*.pyd

# Sensitive / local data (never a token nor a key in plaintext)
.env
*.env
!*.env.example
credentials.json
recovery.json

# Editors / OS
.vscode/
.idea/
.DS_Store

# Dev artifacts / screenshots
*.svg