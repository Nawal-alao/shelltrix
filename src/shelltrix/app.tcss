/* =====================================================================
   shelltrix — "premium flat" design system, OpenCode Zen style
   Design tokens provided by the active theme (src/shelltrix/themes.py):
   $bg, $pane, $surface, $border, $hover, $text, $muted, $primary,
   $secondary, $accent, $section, $accent_text, $warning, $error,
   $success, $modal_border.

   UI rules:
   - 4px/8px grid, no big frames, hairline separators only
   - three continuous columns (left sidebar · chat · right sidebar)
   - discreet top bar and footer, flat toasts with automatic expiry
   - "Less UI, more content".
   ===================================================================== */

/* -- Base ----------------------------------------------------------- */

Screen {
    background: $bg;
}

/* -- Footer: shortcuts (^R Rooms, ^L Compose, ^P Commands, …) -------- */

Footer {
    background: $bg;
    color: $muted;
    scrollbar-size: 0 0;
}

Footer .footer-key--key {
    color: $muted;
    background: transparent;
    text-style: bold;
    padding: 0 1;
}

Footer .footer-key--description {
    color: #444444;
    background: transparent;
    padding: 0 1 0 0;
}

/* =====================================================================
   Buttons — unified flat style, consistent with the composer (_SendButton)
   Base: no border nor bold, surface at rest / hover on hover.
   Intent classes:
     Button.-primary → $primary background, $accent_text text, bold
                       (confirm/accept action).
     Button.-danger  → transparent background, $error text, left $error
                       vkey bar (destructive / risky cancel action).
   Neutral buttons (Cancel/Close) keep the default class, no intent
   class: sober base only.
   ===================================================================== */

Button {
    border: none;
    background: $surface;
    color: $text;
    text-style: not bold;
    padding: 0 2;
    min-width: 14;
    height: 3;
}

Button:hover {
    background: $hover;
}

Button:focus {
    background: $hover;
}

Button.-primary {
    background: $primary;
    color: $accent_text;
    text-style: bold;
}

Button.-primary:hover {
    background: $primary;
}

Button.-danger {
    background: transparent;
    color: $error;
    border-left: vkey $error;
}

Button.-danger:hover {
    background: $hover;
}

/* =====================================================================
   Notifications (toasts) — flat, small 1px left border, auto-expire
   ===================================================================== */

Toast {
    width: 42;
    max-width: 40%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
    background: transparent;
    border: none;
    color: $muted;
    border-left: vkey $success;
}

Toast .toast--title {
    text-style: bold;
    color: $muted;
}

Toast.-warning {
    border-left: vkey $warning;
}

Toast.-error {
    border-left: vkey $error;
}

ToastRack {
    margin-bottom: 1;
}

/* =====================================================================
   Login — centered welcome card
   ===================================================================== */

LoginScreen, AccountPickerScreen {
    align: center middle;
}

#login-wrap {
    align: center middle;
    width: 100%;
    height: 1fr;
}

#login-card {
    width: 64;
    max-width: 90%;
    height: auto;
    border: solid $border;
    background: $pane;
    padding: 1 3;
    color: $text;
}

#brand {
    content-align: center middle;
    text-style: bold;
    color: $primary;
    padding-bottom: 0;
}

#tagline {
    content-align: center middle;
    color: $muted;
    padding-bottom: 1;
}

#login-card Rule {
    color: $border;
    background: $border 25%;
    padding-bottom: 1;
    margin-bottom: 1;
}

.login-field {
    margin-bottom: 1;
    border: solid $border;
    background: $surface;
    color: $text;
}

.login-field:focus {
    border: solid $primary;
}

#login-button {
    margin-top: 1;
}

#login-status {
    margin-top: 1;
    height: 1;
    color: $muted;
    text-style: bold;
}

#login-status.error {
    color: $error;
}

#login-status.success {
    color: $success;
}

#login-hint {
    margin-top: 2;
    color: $muted;
}

/* =====================================================================
   Account picker (multi-account)
   ===================================================================== */

#accounts-header {
    padding: 0 1;
    color: $muted;
    text-style: bold;
}

.account-list {
    height: auto;
    max-height: 12;
    background: transparent;
    border: none;
    padding: 0;
}

.account-list ListItem {
    padding: 0 1;
    height: 2;
    background: transparent;
    color: $text;
}

.account-list ListItem.-highlight,
.account-list ListItem:hover {
    background: $hover;
}

#account-actions {
    height: 3;
    width: 100%;
    margin-top: 1;
}

#account-actions Button {
    margin-right: 1;
    min-width: 14;
}

/* =====================================================================
   Chat — discreet status bar on top (blended into the background, hairline)
   ===================================================================== */

#top-bar {
    height: 2; /* 1 content line + 1 bottom border line */
    background: transparent;
    border-bottom: solid $surface;
    padding: 0 1;
}

#room-title {
    width: 1fr;
    content-align: left middle;
    color: $text;
}

#sync-status {
    width: auto;
    content-align: right middle;
    color: $muted;
    padding: 0 0 0 1;
}

#clock {
    width: auto;
    content-align: right middle;
    color: $muted;
}

/* -- Main layout -------------------------------------------------- */

#main {
    height: 1fr;
}

/* Continuous columns: the separators are $surface hairlines at the
   junction of the panels, never a frame around a zone. */
#room-panel {
    width: 30;
    height: 1fr;
    background: $pane;
    border-right: solid $surface;
}

/* Brand at the top of the left sidebar (the "shelltrix" of the sketch).
   height 2: 1 text line + 1 bottom border line. */
#brand-sidebar {
    height: 2;
    padding: 0 1;
    content-align: left middle;
    text-style: bold;
    color: $primary;
    border-bottom: solid $surface;
}

/* Section title: ┌─┐ / │ ROOMS │ / └─┐ frame drawn in markup
   (see sidebar.box_header), hence a height of 3 lines. The content stays
   aligned on the item grid (1 col of padding on each side), so the frame
   reaches the panel edge. */
#room-list-header {
    height: 3;
    content-align: left middle;
    color: $muted;
    padding: 0 1;
}

#room-list {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

/* Each room fits a compact single line: tree branch (├─) + name (1fr,
   truncated by "…") + unread badge aligned right, no background nor big
   block. */
#room-list ListItem {
    height: 1;
    padding: 0 1;
    overflow: hidden;
    text-wrap: nowrap;
    background: transparent;
}

#room-list .room-row {
    width: 1fr;
    height: 1;
}

/* The branch is a fixed column: the name keeps everything else. */
#room-list .room-stem {
    width: auto;
    margin-right: 1;
    color: $muted;
    text-wrap: nowrap;
}

#room-list .room-name {
    width: 1fr;
    color: $muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
    overflow: hidden;
}

#room-list .room-badge {
    width: auto;
    margin-left: 1;
    color: $error;
    text-wrap: nowrap;
}

#room-list .room-badge.mention {
    color: $accent;
    text-style: bold;
    text-wrap: nowrap;
}

/* Hover/selection: only a brightness variation. */
#room-list ListItem.active {
    background: $hover;
}

#room-list ListItem.active .room-name {
    color: $text;
}

#room-list:focus > ListItem.-highlight,
#room-list:blur > ListItem.-highlight {
    background: $hover;
}

#room-list:focus > ListItem.-highlight .room-name,
#room-list:blur > ListItem.-highlight .room-name {
    color: $text;
}

/* Center column: no frame, background slightly darker than the
   panels. The scrollbar gutter is handled in #timeline (the real
   scrollable widget), not here: this Vertical is not scrollable. */
#chat-area {
    height: 1fr;
    background: $bg;
    border: none;
    border-right: none;
}

/* The timeline text is aligned on the composer grid:
   panel column 1 = prompt ">" (1 col) + space (1 col) = col 3.
   The container is scrollable: its scrollbar gutter (black band)
   must be hidden — scrollbar-size 0 does not prevent scrolling (keyboard,
   wheel), it only hides the visual bar. */
#timeline {
    height: 1fr;
    padding: 1 3 0 3;
    background: $bg;
    color: $text;
    scrollbar-size: 0 0;
}

/* One message = one widget. Hover flags it without coloring: the
   conversation stays the content, the target is only a mouse cue.
   (The folding / reactions / "see more" styles live in the
   DEFAULT_CSS of MessageView, with the widget.) */
#timeline > .timeline-message:hover {
    background: $surface;
}

/* Separators (day change, silence): an empty line then the rule,
   like the sidebar separators. */
#timeline > .tl-gap {
    height: 1;
}
#timeline > .tl-sep {
    height: 1;
}

/* -- Splash screen (SHELLTRIX banner on launch) --------------------- */
/* Composition: LOGO → tagline → keyboard hint, strict hierarchy, wide
   negative space. #splash-wrap takes the whole screen: the group
   (#splash-group, 1fr) stays perfectly centered on screen while
   #splash-detail is folded bottom-left — no settling of the logo. The
   group is moved above center (asymmetry) via the bottom margin
   of the hint. A light breathing space separates the texts (logo from
   hint), like in the command palette. */

SplashScreen {
    background: $bg;
    align: center middle;
}

#splash-wrap {
    width: 100%;
    height: 100%;
}

#splash-group {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#splash-art {
    width: auto;
    height: auto;
}

#splash-sub {
    width: auto;
    height: auto;
    color: $muted;
    margin-top: 1;
}

#splash-hint {
    width: auto;
    height: auto;
    color: $muted;
    text-style: dim;
    margin-top: 2;
    margin-bottom: 2;
}

/* Discreet micro technical details, folded bottom-left (outside the
   centered flow: never in visual competition with the logo). */
#splash-detail,
#splash-version {
    width: auto;
    height: auto;
    color: $muted;
    text-style: dim;
    margin-left: 1;
}

#splash-version {
    margin-top: 1;
}

/* Small terminals (no CSS media queries in Textual): the SplashScreen toggles
   these classes from Python by height. 'splash-squeeze' tightens the margins
   (14-15 lines), 'splash-tiny' hides the hint (< 14 lines). */
.-splash-squeeze #splash-sub, .-splash-tiny #splash-sub {
    margin-top: 1;
}

.-splash-squeeze #splash-hint {
    margin-top: 2;
    margin-bottom: 1;
}

.-splash-tiny #splash-hint {
    display: none;
}

/* Under ~66 columns the fixed ASCII block (66 cols wide) would be cut
   on the right: we hide the logo rather than breaking the letters. */
.-splash-no-logo #splash-art {
    display: none;
}

/* -- Right sidebar (contextual Room / Session panels) --------------- */

#sidebar {
    width: 30;
    height: 1fr;
    background: $pane;
    border-left: solid $surface;
    padding: 1 1;
    color: $text;
}

/* ROOM / SESSION panels: "├─ …" lines (see sidebar.tree_block). Each
   value fits on a single panel line — too long, it is truncated with "…"
   rather than folded, otherwise its continuation would end up under the
   branch, with no cue of attachment. */
#sidebar > Static {
    width: 100%;
    height: auto;
    padding-bottom: 0;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* SESSION is followed by a simple blank line (padding-top): its frame
   ┌───┐ already plays the role of separator between the two panels. */
#sb-session {
    padding-top: 1;
}

/* -- Input bar ----------------------------------------------------- */

/* Docked at the bottom of the chat column: no box, ultra-dark top
   border (#141414), green cursor/accent, discreet "→" button. */
#input-bar {
    dock: bottom;
    height: 2;
    background: $bg;
    border-top: solid #141414;
    padding: 0 1;
}

/* ">" prompt in the flow (not docked): 1 cell + 1 space, then the
   composer starts on the same grid as the timeline text. */
#input-prompt {
    width: auto;
    padding: 0 1 0 0;
    color: $accent;
    text-style: bold;
    content-align: left middle;
}

#composer {
    width: 1fr;
    min-width: 0;
    height: 1;
    background: transparent;
    color: $text;
    border: none;
    padding: 0 4 0 0;
}

/* Input locked until a room is opened: less visible. */
#composer:disabled {
    opacity: 60%;
}

#composer:focus {
    background: transparent;
    border: none;
}

/* Cursor in the accent color (green on matrix_green, orange on
   opencode); placeholder in secondary text. */
#composer .input--cursor {
    background: $accent;
    color: $accent_text;
    text-style: bold;
}

#composer .input--placeholder {
    color: $muted;
}

/* Send button: clickable Static, flat, muted, revealed on hover. */
#composer-send {
    dock: right;
    width: 3;
    min-width: 3;
    height: 1;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: $muted;
    content-align: center middle;
}

#composer-send:hover {
    background: $hover;
    color: $accent;
}

/* Slash command autocompletion (fuzzy search): thin bar
   above the composer, text aligned on the same grid. */
#suggestion-list {
    display: none;
    height: auto;
    max-height: 9;
    border: hkey $border;
    background: $surface;
    margin: 0 1 0 1;
    padding: 0;
    scrollbar-size: 1 1;
    scrollbar-color: $border;
    scrollbar-background: $surface;
}

#suggestion-list ListItem {
    padding: 0 2;
    min-height: 1;
    background: transparent;
    color: $text;
}

#suggestion-list ListItem.-highlight,
#suggestion-list ListItem:hover {
    background: $hover !important;
    color: $text;
}

/* Typing indicator — discreet, above the composer */
#typing-status {
    display: none;
    height: 1;
    padding: 0 1;
    color: $muted;
    background: transparent;
}

/* =====================================================================
   Command palette (opencode style: centered "Commands" dialog)
   Premium flat: minimalist, readable, well structured.
   ===================================================================== */

ModalScreen {
    align: center middle;
    background: $bg 85%;
}

CommandPalette,
SearchDialog {
    align: center middle;
    background: $bg 85%;
}

#cp-dialog {
    width: 62;
    max-width: 94%;
    height: auto;
    max-height: 80%;
    border: $modal_border;
    background: $surface;
    padding: 1 0;
}

/* -- Header (Commands / esc) --------------------------------------- */

#cp-header {
    height: 1;
    width: 100%;
    padding: 0 2;
    margin-bottom: 1;
}

#cp-header-title {
    color: $text;
    text-style: bold;
}

#cp-header-esc {
    dock: right;
    color: $muted;
}

/* -- Search ------------------------------------------------------- */

#cp-input {
    background: transparent;
    border: none;
    height: 1;
    padding: 0 2;
    margin-bottom: 1;
    color: $text;
}

#cp-input:focus {
    background: transparent;
    border: none;
}

#cp-input .input--placeholder {
    color: $muted;
}

#cp-input .input--cursor {
    background: $primary;
    color: $accent_text;
}

/* -- List ---------------------------------------------------------- */

#cp-list {
    background: transparent;
    border: none;
    height: auto;
    max-height: 100%;
    padding: 0;
    scrollbar-size: 0 0;
}

#cp-list ListItem {
    padding: 0 2;
    height: 1;
    background: transparent;
    color: $text;
}

.cp-row {
    width: 100%;
    height: 1;
    background: transparent;
    align: left middle;
}

/* Title + description */
.cp-row-title {
    width: 1fr;
    background: transparent;
}

/* Keyboard shortcut */
.cp-row-right {
    dock: right;
    width: auto;
    content-align: right middle;
    color: $muted;
}

/* -- Section headers -------------------------------------------- */

.cp-section {
    padding: 0;
    height: 1;
    width: 100%;
    color: $primary;
    text-style: bold;
    background: transparent;
}

#cp-list ListItem.cp-header-item {
    height: 2;
    padding: 1 2 0 2;
    background: transparent;
}

#cp-list ListItem.cp-header-item:first-of-type {
    height: 1;
    padding: 0 2;
}

/* -- Selection & Highlight --------------------------------------- */

#cp-list ListItem.-highlight,
#cp-list:focus > ListItem.-highlight,
#cp-list ListItem:hover {
    background: $primary;
    color: $accent_text;
}

#cp-list ListItem.-highlight .cp-row-title,
#cp-list:focus > ListItem.-highlight .cp-row-title,
#cp-list ListItem:hover .cp-row-title,
#cp-list ListItem.-highlight .cp-row-right,
#cp-list:focus > ListItem.-highlight .cp-row-right,
#cp-list ListItem:hover .cp-row-right {
    color: $accent_text;
}

/* Headers must never be highlighted */
#cp-list ListItem.cp-header-item:hover,
#cp-list ListItem.cp-header-item.-highlight,
#cp-list:focus > ListItem.cp-header-item.-highlight {
    background: transparent;
}

/* -- Empty state ---------------------------------------------------- */

#cp-empty {
    display: none;
    padding: 1 2;
    color: $muted;
    content-align: center middle;
    text-style: italic;
}

/* -- Modal "Join a room" --------------------------------------------- */

JoinRoomDialog {
    align: center middle;
    background: $bg 85%;
}

#jr-dialog {
    width: 56;
    max-width: 94%;
    height: auto;
    border: $modal_border;
    background: $surface;
    padding: 1 2;
}

#jr-title {
    width: 100%;
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#jr-alias {
    background: $pane;
    border: solid $border;
    color: $text;
    margin-bottom: 1;
}

#jr-alias:focus {
    border: solid $primary;
}

#jr-buttons {
    height: 3;
    width: 100%;
    align-horizontal: right;
}

#jr-buttons Button {
    margin-left: 1;
}

/* =====================================================================
   Emoji device verification (SAS) — human confirmation
   ===================================================================== */

SasDialog {
    align: center middle;
    background: $bg 85%;
}

#sas-dialog {
    width: 56;
    max-width: 94%;
    height: auto;
    border: $modal_border;
    background: $surface;
    padding: 1 2;
}

#sas-title {
    content-align: left top;
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#sas-device {
    color: $muted;
    padding-bottom: 1;
}

#sas-hint {
    color: $muted;
    padding-bottom: 1;
}

#sas-emojis {
    height: auto;
    margin-bottom: 1;
}

.sas-emoji {
    height: 1;
    color: $text;
    padding: 0 0 0 1;
}

#sas-actions {
    height: auto;
    align: right middle;
    padding-top: 1;
}

#sas-actions Button {
    margin-left: 1;
    min-width: 14;
}

/* =====================================================================
   Human confirmation of invites
   ===================================================================== */

InviteDialog {
    align: center middle;
    background: $bg 85%;
}

#invite-dialog {
    width: 60;
    max-width: 94%;
    height: auto;
    border: $modal_border;
    background: $surface;
    padding: 1 2;
}

#invite-title {
    content-align: left top;
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#invite-room {
    color: $text;
    padding-bottom: 1;
}

#invite-sender {
    color: $muted;
    padding-bottom: 1;
}

#invite-hint {
    color: $muted;
    padding-bottom: 1;
}

#invite-actions {
    height: auto;
    align: right middle;
    padding-top: 1;
}

#invite-actions Button {
    margin-left: 1;
    min-width: 14;
}

/* =====================================================================
   Session recovery key (E2EE) — management and restoration
   ===================================================================== */

RecoveryDialog,
StoreUnlockDialog {
    align: center middle;
    background: $bg 85%;
}

#rec-dialog {
    width: 64;
    max-width: 94%;
    height: auto;
    border: $modal_border;
    background: $surface;
    padding: 1 2;
}

#rec-title {
    content-align: left top;
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#rec-hint {
    color: $muted;
    padding-bottom: 1;
}

#rec-key {
    width: 100%;
    height: auto;
    padding: 1 1;
    background: $pane;
    border: solid $border;
    color: $text;
    text-wrap: wrap;
    margin-bottom: 1;
}

#rec-actions {
    height: auto;
    align: right middle;
}

#rec-actions Button {
    margin-left: 1;
    min-width: 12;
}

#unlock-dialog {
    width: 64;
    max-width: 94%;
    height: auto;
    border: $modal_border;
    background: $surface;
    padding: 1 2;
}

#unlock-title {
    content-align: left top;
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#unlock-hint {
    color: $muted;
    padding-bottom: 1;
}

#unlock-key {
    background: $pane;
    border: solid $border;
    color: $text;
    margin-bottom: 1;
}

#unlock-key:focus {
    border: solid $primary;
}

#unlock-status {
    height: auto;
    min-height: 1;
    color: $muted;
    margin-bottom: 1;
}

#unlock-status.error {
    color: $error;
}

#unlock-status.success {
    color: $success;
}

#unlock-actions {
    height: auto;
    align: right middle;
}

#unlock-actions Button {
    margin-left: 1;
    min-width: 14;
}